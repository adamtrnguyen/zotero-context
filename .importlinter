# Derived from the code, by reading every import in `src/zotero_writes` (there are no
# others: the package's only third-party dependency is `zotero_context`, and the
# transports are stdlib `urllib`). Both root packages are here because the single most
# load-bearing rule in this repo is a rule ABOUT THE PAIR, and it is unenforceable from
# inside either one alone.
#
# WHY zotero_context IS A ROOT PACKAGE HERE AND NOT IN core/
# ---------------------------------------------------------
# README.md: "core/ stays read-only forever... The dependency runs writes/ -> core/ and
# never the reverse, which is what lets this rule stand unamended." That sentence is the
# justification for core's whole charter -- `writes/README.md` spends three paragraphs on
# it -- and until now nothing checked it. It has to be checked from here, because this is
# the only venv where BOTH packages are importable: `writes` depends on `core` through an
# editable path dependency, while `core` has `dependencies = []` and cannot see `writes`
# at all. A contract in core/ could not even name `zotero_writes`.
[importlinter]
root_packages =
    zotero_writes
    zotero_context
# Required because the forbidden contracts below name modules outside the root packages
# (`sqlite3`, `mcp`); without it import-linter errors instead of checking them.
include_external_packages = True

# --------------------------------------------------------------------------
# 1. the suite-level direction
# --------------------------------------------------------------------------
[importlinter:contract:suite-direction]
name = core is the read half and never imports the write half
type = layers
layers =
    zotero_writes
    zotero_context

# --------------------------------------------------------------------------
# 2. the internal spine
# --------------------------------------------------------------------------
# Read off the imports rather than designed. Bottom to top:
#
#   errors, journal    no intra-package imports at all. Independent of each other.
#   linker, cookjohn   import `.errors` only. Independent of each other -- they are the
#                      two transports and neither knows the other exists, which is the
#                      property that lets a verb need one and not the other.
#   liveness           imports `.linker`, `.cookjohn`, `.errors`. It is the only module
#                      that knows about both transports, because distinguishing "Zotero
#                      is down" from "one plugin is missing" needs both probes.
#   writes, collections  the verbs. NON-INDEPENDENT siblings (`:` not `|`): they import
#                      each other through deferred function-level imports --
#                      `writes.create_item` calls `collections.add_items_to_collection`
#                      to file a new item, and both collection-membership verbs call
#                      `writes.check_keys`/`require_items`. That cycle is real and
#                      declaring it is more honest than splitting the layer to hide it.
#   mcp_server         the adapter. Imports both verb modules and nothing imports it.
#
# `zotero_writes/__init__.py` is deliberately not a layer: it imports every module by
# design, being the public surface.
[importlinter:contract:writes-spine]
name = zotero_writes layers: adapter above verbs above liveness above transports above errors
type = layers
layers =
    zotero_writes.mcp_server
    zotero_writes.writes : zotero_writes.collections
    zotero_writes.liveness
    zotero_writes.linker | zotero_writes.cookjohn
    zotero_writes.errors | zotero_writes.journal

# --------------------------------------------------------------------------
# 3. no SQL in the write path
# --------------------------------------------------------------------------
# README.md's rules of the road: "Never open zotero.sqlite read-write". `writes/README.md`
# claims the stronger form as already true -- "both remain literally true: nothing here
# executes SQL" -- and it is (verified: `grep -rn sqlite3 src/` is empty). Every read a
# gate needs comes from `zotero_context`, which opens the database `-readonly` with an
# `immutable=1` fallback. A local `sqlite3.connect()` here would be a second, ungated
# path to the same file, in the package whose entire purpose is that there is one path.
#
# `allow_indirect_imports = True` is REQUIRED here and is not a loosening -- without it
# the contract fails on `zotero_writes.collections -> zotero_context.items -> sqlite3`,
# which is the sanctioned path this rule exists to funnel reads INTO. The rule is "no
# `import sqlite3` in this package", not "never reach a module that opens the database";
# the latter would forbid reading anything at all.
[importlinter:contract:no-sql-in-the-write-path]
name = zotero_writes reaches the database only through zotero_context
type = forbidden
source_modules =
    zotero_writes
forbidden_modules =
    sqlite3
allow_indirect_imports = True

# --------------------------------------------------------------------------
# 4. `mcp` belongs to the adapter alone
# --------------------------------------------------------------------------
# `cookjohn.py`: "this module is stdlib-only too: urllib and json, nothing else... it can
# at least be VENDORED [into calibre-zotero-jump] verbatim instead of rewritten."
# `calibre-zotero-jump/ui.py` runs inside Calibre's embedded Python, which cannot see a uv
# virtualenv, so an `mcp` import anywhere in the write path would make the package
# unvendorable -- and would force every consumer to install an async runtime to import a
# tag verb. `mcp_server` is excluded because it is the one module allowed to import it,
# and it does so INSIDE `main()`; a test asserts that too, from the other direction.
[importlinter:contract:mcp-only-in-the-adapter]
name = only mcp_server may import mcp, so the write path stays stdlib-only and vendorable
type = forbidden
source_modules =
    zotero_writes.writes
    zotero_writes.collections
    zotero_writes.liveness
    zotero_writes.linker
    zotero_writes.cookjohn
    zotero_writes.errors
    zotero_writes.journal
forbidden_modules =
    mcp
